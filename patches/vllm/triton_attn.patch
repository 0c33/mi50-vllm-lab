+    def _forward_pth_dec(
+        self,
+        query: torch.Tensor,
+        key_cache: torch.Tensor,
+        value_cache: torch.Tensor,
+        k_scale_cache: torch.Tensor,
+        v_scale_cache: torch.Tensor,
+        block_table: torch.Tensor,
+        seq_lens: torch.Tensor,
+        query_start_loc: torch.Tensor,
+        output: torch.Tensor,
+        max_q: int,
+        attn_metadata: TritonAttentionMetadata,
+    ) -> bool:
+        """Attention for sequences with <= 4 query tokens via the gfx906 split-K
+        decode kernel. Launch-only (no host sync, no allocation): safe in graphs."""
+        if self._pth_dec_ok is None:
+            self._pth_dec_ok = bool(
+                self._pth_dec.supported_layout(
+                    key_cache, value_cache, k_scale_cache, v_scale_cache
+                )
+            )
+            if not self._pth_dec_ok:
+                logger.warning_once(
+                    "gfx906: unexpected int8 KV cache layout; decode stays on Triton"
+                )
+        segm_o = attn_metadata.softmax_segm_output
+        if (
+            not self._pth_dec_ok
+            or segm_o is None
+            or attn_metadata.softmax_segm_max is None
+            or attn_metadata.softmax_segm_expsum is None
+            or query.shape[0] > segm_o.shape[0]
+            or query.dim() != 3
+            or output.dim() != 3
+            or query.stride(1) != query.shape[2]
+            or query.stride(2) != 1
+            or output.stride(2) != 1
+        ):
+            return False
+        self._pth_dec.decode(
+            query,
+            key_cache,
+            value_cache,
+            k_scale_cache,
+            v_scale_cache,
+            block_table,
+            seq_lens,
+            query_start_loc,
+            output,
+            self.scale,
+            segm_o,
+            attn_metadata.softmax_segm_max,
+            attn_metadata.softmax_segm_expsum,
+            seq_lens.shape[0],
+            max(1, max_q),
+            min(_PTH_DEC_SPLITS, segm_o.shape[2]),
+        )
+        return True
+
+    def _forward_pth_fa(
+        self,
+        query: torch.Tensor,
+        key_cache: torch.Tensor,
+        value_cache: torch.Tensor,
+        k_scale_cache: torch.Tensor,
+        v_scale_cache: torch.Tensor,
+        attn_metadata: TritonAttentionMetadata,
+        output: torch.Tensor,
+    ) -> bool:
+        """Run the rows with >= _PTH_FA_MIN_Q queries through the gfx906 FA kernel.
+
+        Those rows must form a suffix of the batch (hybrid models order the
+        batch decode-first); the rows before it go to the Triton kernel as
+        before. Eager only: prefill batches run outside CUDA graphs.
+        """
+        qsl = attn_metadata.query_start_loc_cpu.tolist()
+        n = len(qsl) - 1
+        p = n
+        while p > 0 and qsl[p] - qsl[p - 1] >= _PTH_FA_MIN_Q:
+            p -= 1
+        if p == n:
+            return False
+        max_q_prefix = max((qsl[i + 1] - qsl[i] for i in range(p)), default=0)
+        if p > 0 and not (
+            self._pth_dec is not None
+            and max_q_prefix <= _PTH_DEC_MAX_Q
+            and self._forward_pth_dec(
+                query[: qsl[p]],
+                key_cache,
+                value_cache,
+                k_scale_cache,
+                v_scale_cache,
+                attn_metadata.block_table[:p],
+                attn_metadata.seq_lens[:p],
+                attn_metadata.query_start_loc[: p + 1],
+                output[: qsl[p]],
+                max_q_prefix,
+                attn_metadata,
+            )
+        ):
+            unified_attention(
+                q=query[: qsl[p]],
+                k=key_cache,
+                v=value_cache,
+                out=output[: qsl[p]],
+                cu_seqlens_q=attn_metadata.query_start_loc[: p + 1],
+                max_seqlen_q=max_q_prefix,
+                seqused_k=attn_metadata.seq_lens[:p],
+                max_seqlen_k=attn_metadata.max_seq_len,
+                softmax_scale=self.scale,
+                causal=True,
+                window_size=self.sliding_window,
+                block_table=attn_metadata.block_table[:p],
+                softcap=self.logits_soft_cap,
+                q_descale=None,
+                k_descale=None,
+                v_descale=None,
+                seq_threshold_3D=attn_metadata.seq_threshold_3D,
+                num_par_softmax_segments=attn_metadata.num_par_softmax_segments,
+                softmax_segm_output=attn_metadata.softmax_segm_output,
+                softmax_segm_max=attn_metadata.softmax_segm_max,
+                softmax_segm_expsum=attn_metadata.softmax_segm_expsum,
+                kv_quant_mode=self._kv_quant_mode,
+                k_scale_cache=k_scale_cache,
+                v_scale_cache=v_scale_cache,
+            )
+        num_heads, head_size = query.shape[1], query.shape[2]
+        for i in range(p, n):
+            start, nq = qsl[i], qsl[i + 1] - qsl[i]
+            # fp32 Q padded to the kernel's 64-column tiles; pad rows are discarded
+            q_pad = torch.zeros(
+                (1, num_heads, (nq + 63) // 64 * 64, head_size),
+                dtype=torch.float32,
+                device=query.device,
+            )
+            q_pad[0, :, :nq] = query[start : start + nq].transpose(0, 1)
+            seq_len = attn_metadata.seq_lens[i : i + 1]
+            out = self._pth_fa.forward_pth(
+                q_pad,
+                key_cache,
+                value_cache,
+                attn_metadata.block_table[i : i + 1],
+                seq_len,
+                self.scale,
+                seq_len - nq,
+            )
+            output[start : start + nq] = out[0, :nq]
+        return True
