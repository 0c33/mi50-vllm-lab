+    # freed/placeholder blocks and the drafts collapse to garbage (0 % accepted
+    # beyond ~2-4k context). `nc_window` keeps the window for the clip, and
+    # _noncausal_window_args expresses "no causal clip, left window only" with
+    # the kernel's existing causal+window mask.
+    nc_window = 0
     if non_causal:
