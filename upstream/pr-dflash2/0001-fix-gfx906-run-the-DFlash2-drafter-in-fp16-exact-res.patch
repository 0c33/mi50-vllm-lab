+@torch.no_grad()
+def rescale_residual_stream(model: "DFlash2Qwen3Model", divisor: float) -> None:
+    """Shrink the draft's residual stream by `divisor` without changing its output.
+
+    The bf16-trained DFlash2 draft's residual stream passes fp16's max (65504)
+    within two layers; cast to fp16, it turns into inf/NaN, every candidate id
+    becomes 0..top_k-1 and acceptance is exactly zero (vllm-project/vllm#55250).
+    Every branch reads the stream through an RMSNorm, the final norm feeds the
+    candidates and the selector, and the grouped conv's `finish` is linear in
+    the branch output (its coefficients come from the normed input), so scaling
+    each branch's output projection -- and the layer-0 residual -- by one
+    constant leaves everything the draft computes unchanged. Part of the scale
+    goes on the up half of gate_up_proj so the MLP's intermediate product
+    cannot overflow either. Powers of two keep the weight scaling exact.
+    """
+    up_divisor = min(divisor, 8.0)
+    for layer in model.layers:
+        o_proj = layer.self_attn.o_proj
+        o_proj.weight.mul_(1.0 / divisor)
+        if getattr(o_proj, "bias", None) is not None:
+            o_proj.bias.mul_(1.0 / divisor)
+        gate_up = layer.mlp.gate_up_proj.weight
+        gate_up[gate_up.shape[0] // 2 :].mul_(1.0 / up_divisor)
+        layer.mlp.down_proj.weight.mul_(up_divisor / divisor)
+        layer.residual_scale = 1.0 / divisor
+
+
 def _score_edges(
     predecessor_table: torch.Tensor,
     successor_table: torch.Tensor,
@@ -279,6 +316,19 @@ class DFlash2Qwen3ForCausalLM(DFlashQwen3ForCausalLM):
             soft_cap=softcap if softcap > 0 else None,
         )
 
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]):
+        loaded = super().load_weights(weights)
+        # fp16 drafts only (gfx906 has no bf16; fp16 targets cast the draft
+        # too). VLLM_DFLASH2_FP16_RESIDUAL_DIVISOR=1 restores the old behaviour.
+        divisor = float(os.environ.get("VLLM_DFLASH2_FP16_RESIDUAL_DIVISOR", "32"))
+        o_proj = self.model.layers[0].self_attn.o_proj
+        if o_proj.weight.dtype == torch.float16 and divisor != 1.0:
+            rescale_residual_stream(self.model, divisor)
+            logger.info(
+                "DFlash2 draft in float16: residual stream scaled by 1/%g", divisor
+            )
+        return loaded
+
     def compute_candidates(
         self, hidden_states: torch.Tensor
     ) -> tuple[torch.Tensor, torch.Tensor]:
