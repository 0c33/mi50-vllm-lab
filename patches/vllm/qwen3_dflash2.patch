+    def _fit_residual_stream_to_fp16(self) -> None:
+        """Keep the bf16-trained draft's residual stream inside fp16 range.
+
+        Cast to fp16, the stream passes fp16's max (65504) within two layers;
+        the NaNs that follow make every candidate id 0..top_k-1 and acceptance
+        exactly zero (vllm-project/vllm#55250). Every branch reads the stream
+        through an RMSNorm, the final norm feeds the candidates and selector,
+        and the grouped conv's `finish` is linear in the branch output (its
+        coefficients come from the normed input), so scaling each branch's
+        output projection -- and the layer-0 residual -- shrinks the whole
+        stream by one constant without changing anything the draft computes.
+        The up half of gate_up_proj takes part of the scale so the MLP's
+        intermediate product cannot overflow either.
+        """
+        o_proj = self.model.layers[0].self_attn.o_proj
+        if o_proj.weight.dtype != torch.float16:
+            return
+        divisor = float(os.environ.get("VLLM_DFLASH2_FP16_RESIDUAL_DIVISOR", "32"))
+        if divisor == 1.0:
+            return
+        up_divisor = min(divisor, 8.0)
+        with torch.no_grad():
+            for layer in self.model.layers:
+                attn_out = layer.self_attn.o_proj
+                attn_out.weight.mul_(1.0 / divisor)
+                if getattr(attn_out, "bias", None) is not None:
+                    attn_out.bias.mul_(1.0 / divisor)
+                gate_up = layer.mlp.gate_up_proj.weight
+                gate_up[gate_up.shape[0] // 2 :].mul_(1.0 / up_divisor)
+                layer.mlp.down_proj.weight.mul_(up_divisor / divisor)
+                layer.residual_scale = 1.0 / divisor
+        logger.info(
+            "DFlash2 draft in float16: residual stream scaled by 1/%g "
+            "(VLLM_DFLASH2_FP16_RESIDUAL_DIVISOR; 1 disables)",
+            divisor,
+        )
+
     def compute_candidates(
         self, hidden_states: torch.Tensor
     ) -> tuple[torch.Tensor, torch.Tensor]:
