index e7ff2b6..88acdbe 100644
--- a/tests/v1/spec_decode/test_dflash2.py
+++ b/tests/v1/spec_decode/test_dflash2.py
@@ -232,3 +232,160 @@ def test_dflash2_model_decoder_layer_cls(monkeypatch):
     # 4. Assert that the layers are DFlash2Qwen3DecoderLayer (the subclass)
     assert len(model.layers) == 2
     assert isinstance(model.layers[0], DFlash2Qwen3DecoderLayer)
+
+
+def _tiny_dflash2_model(monkeypatch, out_gain: float):
+    """A real DFlash2Qwen3Model on the GPU whose attention core is stubbed out.
+
+    The stub keeps each layer's o_proj (what rescale_residual_stream scales) and
+    replaces the attention kernel with a fixed mixing matrix, so the real
+    residual / norm / grouped-conv / MLP code runs without attention metadata.
+    `out_gain` scales o_proj and down_proj; this toy's residual peaks at ~108x
+    out_gain, and the bf16-trained checkpoint's passes fp16's max (65504) by
+    its second layer. Small gains are not realistic: with an O(1) stream the
+    RMSNorm eps stops being negligible once the stream is divided by 32.
+    """
+    from vllm.config import set_current_vllm_config
+    from vllm.model_executor.models.qwen3_dflash2 import DFlash2Qwen3Model
+    from vllm.platforms import current_platform
+
+    dev = torch.device("cuda")
+    hidden, block = 256, 5
+    current = SimpleNamespace(
+        cache_config=SimpleNamespace(
+            block_size=16,
+            user_specified_block_size=False,
+            kv_cache_dtype_skip_layers=[],
+            cache_dtype="auto",
+            sliding_window=None,
+            enable_prefix_caching=False,
+        ),
+        kv_transfer_config=None,
+        speculative_config=None,
+        attention_config=SimpleNamespace(
+            use_non_causal=False, backend=None, backend_per_kind={}
+        ),
+        parallel_config=SimpleNamespace(
+            prefill_context_parallel_size=1, decode_context_parallel_size=1
+        ),
+        compilation_config=SimpleNamespace(
+            compile_custom_ops=False,
+            custom_ops="all",
+            enabled_custom_ops=set(),
+            static_forward_context={},
+            mode=0,
+        ),
+        model_config=SimpleNamespace(
+            dtype=torch.float32, is_mm_prefix_lm=False, rswa_window=None
+        ),
+        kernel_config=SimpleNamespace(linear_backend="auto"),
+    )
+    monkeypatch.setattr(
+        current_platform,
+        "get_attn_backend_cls",
+        lambda *args, **kwargs: (
+            "vllm.v1.attention.backends.cpu_attn.CPUAttentionBackend"
+        ),
+    )
+
+    class MockGroup:
+        rank_in_group = 0
+        world_size = 1
+
+    monkeypatch.setattr("vllm.distributed.parallel_state._TP", MockGroup())
+    hf_config = SimpleNamespace(
+        vocab_size=1000,
+        hidden_size=hidden,
+        num_hidden_layers=3,
+        num_attention_heads=8,
+        num_key_value_heads=2,
+        max_position_embeddings=2048,
+        rms_norm_eps=1e-6,
+        rope_parameters={},
+        intermediate_size=512,
+        hidden_act="silu",
+        dflash_config={
+            "selector_rank": 4,
+            "selector_top_k": 3,
+            "conv_kernel_size": 2,
+            "conv_group_size": 16,
+            "use_aux_hidden_state": False,
+        },
+    )
+    vllm_config = SimpleNamespace(
+        speculative_config=SimpleNamespace(
+            draft_model_config=SimpleNamespace(hf_config=hf_config, quantization=None),
+            num_speculative_tokens=block - 1,
+            enable_adaptive_verification=False,
+        ),
+        model_config=SimpleNamespace(dtype=torch.float32, is_mm_prefix_lm=False),
+        load_config=SimpleNamespace(quantization=None, quantization_param_path=None),
+    )
+    current.speculative_config = vllm_config.speculative_config
+    vllm_config.compilation_config = current.compilation_config
+    with set_current_vllm_config(current), torch.device(dev):
+        model = DFlash2Qwen3Model(vllm_config=vllm_config)
+
+    gen = torch.Generator(device=dev).manual_seed(7)
+
+    class StubAttention(torch.nn.Module):
+        def __init__(self, o_proj):
+            super().__init__()
+            self.o_proj = o_proj
+            self.register_buffer(
+                "mix",
+                torch.randn(hidden, hidden, generator=gen, device=dev) / hidden**0.5,
+            )
+
+        def forward(self, positions, hidden_states):
+            out, _ = self.o_proj(hidden_states @ self.mix)
+            return out
+
+    with torch.no_grad():
+        for name, param in model.named_parameters():
+            if name.endswith("norm.weight") or "layernorm" in name:
+                param.copy_(1 + 0.1 * torch.randn(param.shape, generator=gen, device=dev))
+            elif "base_kernel" in name:
+                param.copy_(1 + torch.rand(param.shape, generator=gen, device=dev))
+            else:
+                param.copy_(0.05 * torch.randn(param.shape, generator=gen, device=dev))
+        for layer in model.layers:
+            layer.self_attn.o_proj.weight.mul_(out_gain)
+            layer.mlp.down_proj.weight.mul_(out_gain)
+            layer.self_attn = StubAttention(layer.self_attn.o_proj)
+    # 4 draft blocks of `block` tokens (> 16 rows keeps the fp32 GEMMs in fp32).
+    ids = torch.randint(0, hf_config.vocab_size, (4 * block,), generator=gen, device=dev)
+    positions = torch.arange(4 * block, device=dev)
+    return model, ids, positions
+
+
+@pytest.mark.skip_global_cleanup
+def test_dflash2_residual_rescale_is_exact(monkeypatch):
+    """Scaling the residual stream by a power of two changes nothing downstream."""
+    from vllm.model_executor.models.qwen3_dflash2 import rescale_residual_stream
+
+    model, ids, positions = _tiny_dflash2_model(monkeypatch, out_gain=200.0)
+    with torch.no_grad():
+        ref = model(ids, positions)
+        rescale_residual_stream(model, 32.0)
+        got = model(ids, positions)
+    torch.testing.assert_close(got, ref, rtol=1e-4, atol=1e-5)
+
+
+@pytest.mark.skip_global_cleanup
+def test_dflash2_residual_rescale_keeps_fp16_finite(monkeypatch):
+    """vllm#55250: the fp16 draft overflows to inf/NaN; rescaled it matches fp32."""
+    from vllm.model_executor.models.qwen3_dflash2 import rescale_residual_stream
+
+    model, ids, positions = _tiny_dflash2_model(monkeypatch, out_gain=2000.0)
+    with torch.no_grad():
+        ref = model(ids, positions)
+        model.half()
+        assert not torch.isfinite(model(ids, positions)).all(), (
+            "precondition: this residual stream must overflow plain fp16"
+        )
+        rescale_residual_stream(model, 32.0)
+        got = model(ids, positions).float()
+    assert torch.isfinite(got).all()
+    rel = ((got - ref).norm() / ref.norm()).item()
+    assert rel < 2e-2, f"rescaled fp16 draft vs fp32: rel {rel:.4f}"
