+# gfx906: prefill rows of an int8 per-token-head KV cache go through the fork's
+# llama.cpp-derived FA kernel (dp4a Q.K, fp16 P.V), taught to read this cache in
+# place (/opt/gfx906/_gfx906_fa_pth.so, kernels-pp/fa_pth): 3.5x the stock Triton
+# prefill attention, 1.9x the tuned one. VLLM_GFX906_PTH_FA=0 turns it off.
+_PTH_FA_MIN_Q = int(os.environ.get("VLLM_GFX906_PTH_FA_MIN_Q", "64"))
+_pth_fa_mod = None
+# gfx906: rows with <= 4 query tokens (decode, MTP verification, the MTP drafter) go
+# through a split-K decode kernel for the same cache (/opt/gfx906/_gfx906_pth_dec.so,
+# kernels-pp/pth_dec): fp16 dot2 Q.K (no Q quantisation) and P.V, 3-4.5x the Triton
+# 3D decode path at long context, HIP-graph safe; it reuses the 3D path's softmax
+# segment buffers. VLLM_GFX906_PTH_DEC=0 turns it off.
+_PTH_DEC_MAX_Q = 4
+_PTH_DEC_SPLITS = int(os.environ.get("VLLM_GFX906_PTH_DEC_SPLITS", "64"))
+_pth_dec_mod = None
+
+
+def _load_pth_fa():
+    global _pth_fa_mod
+    if _pth_fa_mod is None:
+        _pth_fa_mod = False
+        path = os.environ.get("VLLM_GFX906_PTH_FA_LIB", "/opt/gfx906/_gfx906_fa_pth.so")
+        if os.environ.get("VLLM_GFX906_PTH_FA", "1") == "1" and path and os.path.exists(path):
+            try:
+                import importlib.machinery
+                import importlib.util
+
+                loader = importlib.machinery.ExtensionFileLoader("_gfx906_fa_pth", path)
+                spec = importlib.util.spec_from_loader("_gfx906_fa_pth", loader)
+                mod = importlib.util.module_from_spec(spec)
+                loader.exec_module(mod)
+                _pth_fa_mod = mod
+                logger.info_once("gfx906: int8 KV prefill attention via %s", path)
+            except Exception as e:  # keep serving on the Triton path
+                logger.warning("gfx906: could not load %s (%s); prefill stays on Triton", path, e)
+    return _pth_fa_mod or None
+
+
+def _load_pth_dec():
+    global _pth_dec_mod
+    if _pth_dec_mod is None:
+        _pth_dec_mod = False
+        path = os.environ.get("VLLM_GFX906_PTH_DEC_LIB", "/opt/gfx906/_gfx906_pth_dec.so")
+        if os.environ.get("VLLM_GFX906_PTH_DEC", "1") == "1" and path and os.path.exists(path):
+            try:
