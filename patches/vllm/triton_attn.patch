+
+                loader = importlib.machinery.ExtensionFileLoader("_gfx906_pth_dec", path)
+                spec = importlib.util.spec_from_loader("_gfx906_pth_dec", loader)
+                mod = importlib.util.module_from_spec(spec)
+                loader.exec_module(mod)
+                _pth_dec_mod = mod
+                logger.info_once("gfx906: int8 KV decode attention via %s", path)
+            except Exception as e:  # keep serving on the Triton path
+                logger.warning("gfx906: could not load %s (%s); decode stays on Triton", path, e)
+    return _pth_dec_mod or None
+
